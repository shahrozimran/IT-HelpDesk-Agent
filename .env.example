# OpenAI-compatible Chat Completions endpoint with function/tool calling support.
# Copy to .env and enter your provider's values. Do not share .env.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-4.6
LLM_TIMEOUT=180
# Pinecone vector-based index: bring your own vectors, 384 dimensions, cosine.
# Supply your own keys and Pinecone index host; never commit .env.
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
PINECONE_NAMESPACE=abm-assignment2
# Optional isolated data/evidence directories; must stay within Solution.
APP_DATA_DIR=data
APP_EVIDENCE_DIR=evidence
